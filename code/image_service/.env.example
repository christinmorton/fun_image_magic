# Copy this file to .env (same folder) and fill in your keys. .env is ignored by git.
# Only add the keys you use. No quotes or spaces around the = sign.

# The shared secret the calling app sends to this service (Authorization: Bearer <token>).
# Make one with:  .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(32))"
# and give the same value to the app that calls this service. Without it, every /v1 route refuses requests.
IMAGE_SERVICE_TOKEN=

# Google Gemini (Nano Banana image models): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI (image generation / editing)
OPENAI_API_KEY=

# Anthropic (Claude: reads images and writes text; it does not generate images)
ANTHROPIC_API_KEY=

# ReCraft
RECRAFT_KEY=

# --- Optional settings (the defaults are shown; leave these out to use them) ---
# How long uploaded photos and AI jobs are kept in memory, in seconds (2 hours)
# PHOTO_TTL_SECONDS=7200
# AI images allowed per UTC day; more are refused with 429 (about $0.037 each)
# AI_DAILY_LIMIT=100
# Uploads, renders, layouts and AI jobs allowed per minute per client (0 = no limit)
# RATE_LIMIT_PER_MINUTE=120
# Uploaded videos, kept on disk until the app fetches them (POST /v1/videos)
# The largest video upload, in MB (5 minutes of webcam video is about 150 MB)
# VIDEO_MAX_MB=300
# How much video may be kept at once, in MB; new uploads are refused past it
# VIDEO_STORAGE_MB=3000
# How long videos are kept, in seconds (2 hours)
# VIDEO_TTL_SECONDS=7200
# Where they're kept (default: a folder in the system temp folder; emptied at each start)
# VIDEO_DIR=
